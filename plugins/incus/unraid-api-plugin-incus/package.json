{
  "name": "unraid-api-plugin-incus",
  "version": "0.1.0",
  "description": "Manage LAN-banned Incus agent jails from the Unraid API (GraphQL over the Incus REST socket).",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@nestjs/common": "*",
    "@nestjs/config": "*",
    "@nestjs/graphql": "*",
    "@unraid/shared": "*",
    "class-transformer": "*",
    "class-validator": "*"
  },
  "dependencies": {
    "graphql-subscriptions": "^3.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/graphql": "13.4.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/ws": "^8.5.13",
    "@unraid/shared": "file:.ci-stubs/unraid-shared",
    "@vitest/coverage-v8": "^5.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "typescript": "^5.6.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "qs": "^6.15.3",
    "@graphql-tools/utils": "^12.0.2",
    "@stryker-mutator/core": {
      "minimatch": "^11.0.1"
    },
    "@nestjs/graphql": {
      "ws": "^8.21.1",
      "@graphql-tools/utils": "^12.0.2",
      "subscriptions-transport-ws": {
        "ws": "^7.5.10"
      }
    }
  }
}
