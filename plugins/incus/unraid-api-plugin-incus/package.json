{
  "name": "unraid-api-plugin-incus",
  "version": "0.1.0",
  "description": "Manage LAN-banned Incus agent jails from the Unraid API (GraphQL over the Incus REST socket).",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@nestjs/common": "*",
    "@nestjs/config": "*",
    "@nestjs/graphql": "*",
    "@unraid/shared": "*",
    "class-transformer": "*",
    "class-validator": "*"
  },
  "dependencies": {
    "graphql-subscriptions": "^3.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/graphql": "14.0.3",
    "@unraid/shared": "file:.ci-stubs/unraid-shared",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1"
  },
  "overrides": {
    "qs": "^6.15.3"
  }
}
