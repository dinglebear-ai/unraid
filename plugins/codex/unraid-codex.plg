<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "unraid-codex">
  <!ENTITY author    "Dinglebear AI">
  <!ENTITY version   "20260805.001"> <!-- managed by .github/scripts/plugin_calver.py -->
  <!ENTITY launch    "Settings/CodexSettings">
  <!ENTITY gitURL    "https://raw.githubusercontent.com/dinglebear-ai/unraid/main/plugins/codex">
  <!ENTITY txzURL    "https://github.com/dinglebear-ai/unraid/releases/download/codex-v&version;/&txz;">
  <!ENTITY pluginURL "&gitURL;/unraid-codex.plg">
  <!ENTITY txz       "unraid-codex-20260805.001-x86_64-35.txz">
  <!ENTITY md5       "9a48c3f7c7f05e2a8db353c0bb0d321a">
  <!ENTITY sha256    "c6a3a20085563e572b4d5a49388cd1cdf9e5036979264046112593506f4f9f32">
  <!ENTITY plugin    "/boot/config/plugins/&name;">
  <!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="7.0.0" support="https://github.com/dinglebear-ai/unraid/issues">

<CHANGES>
###2026.08.05
- Build 35 completes the Codex plugin polish pass: verified encrypted backup
  generation, safe restore with automatic rollback, a resilient accessible
  Settings fallback, deterministic shortcut-to-prompt focus, exact package
  structure validation, PHP page linting, explicit Unraid 7.0+ compatibility
  policy, and stronger failed-install and uninstall cleanup.

###2026.08.02
- Build 34 is the first Community Applications release candidate. It adds a
  clean-install provisioner that creates a dedicated, LAN-contained Incus
  container and installs the verified Codex CLI without manual container setup.
- Tracks the latest stable official Codex static x86-64 Linux release using
  canonical URL and GitHub-published SHA-256 validation, atomic installation,
  compatibility checks, app-server smoke testing, and automatic rollback.
- Adds persistent state, encrypted scheduled backups, recovery diagnostics,
  service hardening, configurable shortcuts, and complete install contracts.

###2026.07.23
- Build 15 replaces Unraid's fallback puzzle piece with a packaged,
  high-contrast Codex/OpenAI mark sized for the Settings tile.
- Build 14 adds a native Codex tile and icon to Unraid Settings. Opening the
  tile launches the chathead directly into its real Session Inspector.
- Build 13 streamlines the header and composer, fixes latest-turn context
  accounting, adds quick reasoning and permission controls, turns MCP servers
  into an editable configuration surface, replaces the plugin wall with a
  searchable catalog, and groups tool, skill, and diagnostic activity.
- Build 12 adds phone/tablet full-screen behavior, safe-area and touch-target
  polish, non-shrinking scrollable transcript rows, live model/reasoning/
  permission/personality controls, MCP OAuth and resource inventory, installed
  apps/plugins, and a bounded app-server protocol activity inspector.
- Build 11 adds a persisted Aurora/Unraid theme setting. The Unraid mode uses
  live webGUI tokens, compact dark terminals, simple Thinking disclosures,
  and session-aware approval cards with resolved states.
- Build 10 makes the transcript itself an Aurora Conversation with Aurora
  message actions, moves runtime inventory into the Session Inspector, and
  adds a persisted resizable dock that reflows the stock Unraid page.
- Build 6 replaces the prototype renderer with vendored Aurora registry
  components for messages, reasoning, plans, terminal output, tool calls,
  patches, approvals, elicitation, questions, context usage, and warnings.
- Initial prototype: persistent Aurora Light chathead, Codex app-server
  connection over an authenticated same-origin Unix-socket proxy, ChatGPT
  device login, streamed responses, thread resume, and one-shot approvals.
</CHANGES>

<FILE Name="&plugin;/&txz;">
<URL>&txzURL;</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
if ! echo "&sha256;  &plugin;/&txz;" | sha256sum -c -; then
  echo "ERROR: Unraid Codex package checksum verification failed." &gt;&amp;2
  rm -f &plugin;/&txz;
  exit 1
fi
if mountpoint -q /mnt/user 2>/dev/null; then
  INCUS_ENV=/usr/local/emhttp/plugins/incus/scripts/incus-env.sh
  INCUS_CONFIG=/boot/config/plugins/incus/incus.cfg
  if [ ! -r "$INCUS_ENV" ]; then
    echo "ERROR: Install and configure the Incus plugin before installing Unraid Codex." &gt;&amp;2
    exit 1
  fi
  if [ -r "$INCUS_CONFIG" ]; then . "$INCUS_CONFIG"; fi
  . "$INCUS_ENV"
  export INCUS_DIR
  if ! incus &lt;/dev/null query /1.0 >/dev/null 2&gt;&amp;1; then
    echo "ERROR: Incus is not running. Enable and initialize it before installing Unraid Codex." &gt;&amp;2
    exit 1
  fi
  CODEX_POOL="${STORAGE_POOL_NAME:-default}"
  if ! incus &lt;/dev/null storage show "$CODEX_POOL" >/dev/null 2&gt;&amp;1; then
    echo "ERROR: Incus storage pool '$CODEX_POOL' is not initialized." &gt;&amp;2
    exit 1
  fi
  CODEX_PROFILE="${JAIL_PROFILE:-agent-jail}"
  if ! incus &lt;/dev/null profile show "$CODEX_PROFILE" >/dev/null 2&gt;&amp;1; then
    echo "ERROR: Incus profile '$CODEX_PROFILE' is not initialized." &gt;&amp;2
    exit 1
  fi
fi
upgradepkg --install-new &plugin;/&txz; || exit 1
chmod +x &emhttp;/scripts/*.sh &emhttp;/event/* &emhttp;/container/install-codex-cli.sh 2>/dev/null
mkdir -p &plugin;
chmod 0700 &plugin;
if mountpoint -q /mnt/user 2>/dev/null; then
  if ! &emhttp;/scripts/start-appserver.sh; then
    &emhttp;/scripts/stop-appserver.sh 2&gt;/dev/null || true
    &emhttp;/scripts/configure-nginx.sh --remove 2&gt;/dev/null || true
    rm -f /etc/cron.d/unraid-codex /var/run/unraid-codex-appserver.sock
    echo "ERROR: Unraid Codex installed, but its managed container did not become ready. Partial proxy and schedule state was cleaned up. Check the system log for 'unraid-codex'." &gt;&amp;2
    exit 1
  fi
fi
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
&emhttp;/scripts/stop-appserver.sh 2>/dev/null || true
&emhttp;/scripts/configure-nginx.sh --remove 2>/dev/null || true
rm -f /etc/cron.d/unraid-codex /var/run/unraid-codex-appserver.sock
removepkg &name; 2>/dev/null || true
rm -rf &emhttp;
echo "Unraid Codex removed. Its Incus container, persistent state, backups, and flash configuration were left intact."
</INLINE>
</FILE>

</PLUGIN>
